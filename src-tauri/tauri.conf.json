{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaic",
  "mainBinaryName": "studydesk",
  "version": "0.1.0",
  "identifier": "studydesk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mosaic",
        "width": 1320,
        "height": 860,
        "minWidth": 520,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
